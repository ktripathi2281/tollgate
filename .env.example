# Copy this file to .env (which git ignores) and fill in the values.
# `make run`, `make migrate`, `make test` and `make smoke` load .env into the
# environment. Never commit the real file, and never paste keys anywhere else.

# The database, for `tollgate serve`, `migrate` and `keys`. This is the
# local Postgres from docker-compose.yml (`make db`); its password is for
# that container only.
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate?sslmode=disable
# Tests that need Postgres use it through this variable, each in a schema of
# its own that is dropped afterwards. They are skipped when it is empty.
TOLLGATE_TEST_DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate?sslmode=disable

# Provider API keys. The config names these variables in api_key_env.
# A provider whose key is empty is disabled: its aliases fall back past it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models for `make smoke`, which calls the real APIs. Each provider's smoke
# tests are skipped if its key or model is empty.
SMOKE_OPENAI_MODEL=
SMOKE_ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: point the OpenAI smoke tests at another compatible server.
SMOKE_OPENAI_BASE_URL=
